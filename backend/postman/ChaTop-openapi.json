{
  "openapi": "3.1.0",
  "info": {
    "title": "ChaTop API",
    "description": "Documentation des endpoints de ChaTop",
    "version": "3.0.5"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/users/{id}": {
      "get": {
        "tags": [
          "users-controller"
        ],
        "summary": "Récupère un utilisateur par son identifiant",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Utilisateur trouvé",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserOutputDto"
                }
              }
            }
          },
          "404": {
            "description": "Utilisateur introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFoundExample": {
                    "description": "NotFoundExample",
                    "value": {
                      "code": "USER_NOT_FOUND",
                      "message": "L’utilisateur avec cet ID n’existe pas"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "users-controller"
        ],
        "summary": "Met à jour les informations d’un utilisateur",
        "operationId": "updateUtilisateur",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsersDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Utilisateur mis à jour avec succès",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsersDto"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide ou champs manquants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "BadRequestExample": {
                    "description": "BadRequestExample",
                    "value": {
                      "code": "INVALID_DATA",
                      "message": "Les champs fournis sont invalides"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Utilisateur introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFoundExample": {
                    "description": "NotFoundExample",
                    "value": {
                      "code": "USER_NOT_FOUND",
                      "message": "Impossible de mettre à jour : utilisateur inexistant"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rentals/rentals/{rentalId}": {
      "put": {
        "tags": [
          "rentals-controller"
        ],
        "operationId": "updateRental",
        "parameters": [
          {
            "name": "rentalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RentalsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RentalsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/rentals/save": {
      "post": {
        "tags": [
          "rentals-controller"
        ],
        "summary": "Crée une nouvelle location",
        "operationId": "createRental",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RentalsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Location créée avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RentalsDto"
                },
                "examples": {
                  "SuccessExample": {
                    "description": "SuccessExample",
                    "value": {
                      "id": 123,
                      "startDate": "2025-06-17",
                      "endDate": "2025-06-20",
                      "message": "Rental created !"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Données de location invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "BadRequestExample": {
                    "description": "BadRequestExample",
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Le champ startDate est obligatoire"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/messages/save": {
      "post": {
        "tags": [
          "message-controller"
        ],
        "summary": "Enregistre un nouveau message",
        "operationId": "save",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Message enregistré avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageDto"
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur lors de l'enregistrement du message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Enregistre un nouvel utilisateur",
        "operationId": "createUtilisateur",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsersDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Utilisateur créé avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersDto"
                },
                "examples": {
                  "CreatedExample": {
                    "description": "CreatedExample",
                    "value": {
                      "id": 42,
                      "username": "alice",
                      "email": "alice@example.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Données invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "BadRequestExample": {
                    "description": "BadRequestExample",
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Le champ email est obligatoire"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflit, l’utilisateur existe déjà",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ConflictExample": {
                    "description": "ConflictExample",
                    "value": {
                      "code": "USER_EXISTS",
                      "message": "Le nom d’utilisateur est déjà pris"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Authentifie un utilisateur et retourne un JWT",
        "operationId": "authenticateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authentification réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JwtResponse"
                },
                "examples": {
                  "SuccessExample": {
                    "description": "SuccessExample",
                    "value": {
                      "token": "eyJhbGci...",
                      "type": "Bearer",
                      "id": 42,
                      "username": "alice",
                      "roles": [
                        "ROLE_USER"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requête mal formée (DTO invalid)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "BadRequestExample": {
                    "description": "BadRequestExample",
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Le champ password est obligatoire"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "UnauthorizedExample": {
                    "description": "UnauthorizedExample",
                    "value": {
                      "code": "UNAUTHORIZED",
                      "message": "Email ou mot de passe incorrect"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users/by-name/{name}": {
      "get": {
        "tags": [
          "users-controller"
        ],
        "summary": "Récupère un utilisateur par son nom",
        "operationId": "getUserByUsername",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Utilisateur trouvé",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsersDto"
                }
              }
            }
          },
          "404": {
            "description": "Utilisateur introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFoundExample": {
                    "description": "NotFoundExample",
                    "value": {
                      "code": "USER_NOT_FOUND",
                      "message": "Aucun utilisateur trouvé avec ce nom"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users/by-email/{email}": {
      "get": {
        "tags": [
          "users-controller"
        ],
        "summary": "Récupère un utilisateur par son email",
        "operationId": "getUserByEmail",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Utilisateur trouvé",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsersDto"
                }
              }
            }
          },
          "404": {
            "description": "Utilisateur introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFoundExample": {
                    "description": "NotFoundExample",
                    "value": {
                      "code": "USER_NOT_FOUND",
                      "message": "Aucun utilisateur trouvé avec cet email"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rentals/list": {
      "get": {
        "tags": [
          "rentals-controller"
        ],
        "summary": "Récupère la liste de toutes les locations",
        "operationId": "getAllRentals",
        "responses": {
          "200": {
            "description": "Liste des locations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RentalsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/rentals/find-rentals/{id}": {
      "get": {
        "tags": [
          "rentals-controller"
        ],
        "summary": "Récupère une location par son ID",
        "operationId": "findRentalById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Location trouvée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RentalsDto"
                }
              }
            }
          },
          "404": {
            "description": "Location non trouvée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFoundExample": {
                    "description": "NotFoundExample",
                    "value": {
                      "code": "NOT_FOUND",
                      "message": "Rental with ID 999 not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "getCurrentUser",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/delete/{id}": {
      "delete": {
        "tags": [
          "users-controller"
        ],
        "summary": "Permet à un administrateur de supprimer un utilisateur",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Utilisateur supprimé avec succès"
          },
          "401": {
            "description": "Vous devez être admin pour supprimer un utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "UnauthorizedExample": {
                    "description": "UnauthorizedExample",
                    "value": {
                      "code": "UNAUTHORIZED",
                      "message": "Vous devez être administrateur pour effectuer cette action"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Utilisateur introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFoundExample": {
                    "description": "NotFoundExample",
                    "value": {
                      "code": "USER_NOT_FOUND",
                      "message": "Impossible de supprimer : utilisateur introuvable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rentals/delete-rentals/{id}": {
      "delete": {
        "tags": [
          "rentals-controller"
        ],
        "summary": "Supprime une location par son ID",
        "operationId": "deleteRentalById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Location supprimée avec succès"
          },
          "404": {
            "description": "Location non trouvée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFoundDeleteExample": {
                    "description": "NotFoundDeleteExample",
                    "value": {
                      "code": "NOT_FOUND",
                      "message": "Rental with ID 999 not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UsersDto": {
        "type": "object",
        "description": "Représentation d'un utilisateur",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Identifiant généré",
            "example": 1,
            "readOnly": true
          },
          "email": {
            "type": "string",
            "description": "Adresse e-mail",
            "example": "john.doe@example.com"
          },
          "name": {
            "type": "string",
            "description": "Nom complet",
            "example": "John Doe"
          },
          "password": {
            "type": "string",
            "description": "Mot de passe (en clair pour la création)",
            "example": "s3cr3tP@ss"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date de création",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date de mise à jour",
            "readOnly": true
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "RentalsDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "surface": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "picture": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ownerId": {
            "type": "integer",
            "format": "int32",
            "example": 1
          }
        }
      },
      "MessageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "rentalsId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          }
        }
      },
      "JwtResponse": {
        "type": "object",
        "description": "Réponse après authentification réussie",
        "properties": {
          "token": {
            "type": "string",
            "description": "Le token JWT",
            "example": "eyJhbGciOiJIUzI1Ni..."
          },
          "type": {
            "type": "string",
            "description": "Type de token",
            "example": "Bearer"
          },
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "ID de l’utilisateur",
            "example": 1
          },
          "email": {
            "type": "string",
            "description": "Email de l’utilisateur",
            "example": "john.doe@example.com"
          },
          "roles": {
            "type": "array",
            "description": "Liste des rôles",
            "example": [
              "ROLE_USER"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UserOutputDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserInfoResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "in": "header",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
